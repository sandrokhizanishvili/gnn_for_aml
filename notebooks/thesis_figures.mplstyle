# The matplotlib style of every thesis figure: plt.style.use('thesis_figures.mplstyle') in a notebook of this folder.
# The rules it serves are in the thesis repository, thesis/CLAUDE.md, section "Figures".

# Size: the thesis text is 396 pt = 5.5 in wide. A figure is saved at the size it is printed, never rescaled in LaTeX.
figure.figsize: 5.5, 3.0
figure.dpi: 110
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.02
pdf.fonttype: 42

# Text: a serif font shipped with matplotlib, so a figure looks the same on every machine.
font.family: STIXGeneral
mathtext.fontset: stix
font.size: 9
axes.labelsize: 9
axes.titlesize: 9
xtick.labelsize: 8
ytick.labelsize: 8
legend.fontsize: 8

# Axes: left and bottom only, thin, no grid.
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 0.6
axes.grid: False
xtick.major.width: 0.6
ytick.major.width: 0.6
xtick.minor.width: 0.4
ytick.minor.width: 0.4
xtick.major.size: 3
ytick.major.size: 3
xtick.minor.size: 1.5
ytick.minor.size: 1.5

# Series: four colour-blind-safe colours (Okabe-Ito), each with its own line style, so a print in grey still reads.
axes.prop_cycle: cycler('color', ['0072B2', 'D55E00', '009E73', 'CC79A7']) + cycler('linestyle', ['-', '--', '-.', ':'])
lines.linewidth: 1.3
lines.markersize: 4
patch.linewidth: 0.5

legend.frameon: False
legend.handlelength: 2.4
